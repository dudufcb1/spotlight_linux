#!/usr/bin/env python3
"""
AI Engine para Spotlight Linux
Módulo para integración con Gemini AI
"""

import os
import asyncio
import logging
import json
import time
from typing import Optional, Dict, Any, List
from dataclasses import dataclass

try:
    import google.generativeai as genai
    HAS_GEMINI = True
except ImportError:
    HAS_GEMINI = False

logger = logging.getLogger(__name__)

@dataclass
class AIResponse:
    """Respuesta de la IA con metadatos"""
    content: str
    success: bool
    error_message: Optional[str] = None
    is_markdown: bool = False
    processing_time: float = 0.0
    # Nuevos campos para modo no-grounding
    suggested_commands: Optional[List[str]] = None
    suggested_code_snippets: Optional[List[str]] = None
    is_structured: bool = False  # True si es respuesta estructurada (JSON)

class AIEngine:
    """Motor de IA para procesamiento de consultas"""
    
    def __init__(self, api_key: Optional[str] = None, grounding_enabled: bool = False):
        self.api_key = api_key or os.getenv('GEMINI_API_KEY')
        self.grounding_enabled = grounding_enabled
        self.model = None
        self.model_structured = None  # Modelo para respuestas estructuradas
        self.is_initialized = False
        self.logger = logging.getLogger(__name__)
        
        if not HAS_GEMINI:
            self.logger.warning("Google GenerativeAI no está disponible. Instale: pip install google-generativeai")
            return
            
        if not self.api_key:
            self.logger.warning("API key de Gemini no encontrada. Configure GEMINI_API_KEY en variables de entorno")
            return
            
        self._initialize_gemini()
    
    def _initialize_gemini(self):
        """Inicializar conexión con Gemini"""
        try:
            genai.configure(api_key=self.api_key)
            # Modelo principal para grounding
            self.model = genai.GenerativeModel('gemini-2.5-flash-lite-preview-06-17')
            # Modelo para respuestas estructuradas (sin grounding)
            self.model_structured = genai.GenerativeModel('gemini-2.5-flash')
            self.is_initialized = True
            self.logger.info("Motor AI inicializado correctamente con Gemini")
        except Exception as e:
            self.logger.error(f"Error inicializando Gemini: {e}")
            self.is_initialized = False
    
    def _detect_markdown(self, text: str) -> bool:
        """Detectar si el texto contiene markdown"""
        markdown_indicators = [
            '```', '**', '*', '##', '#', '- ', '1. ', 
            '[', '](', '`', '>', '---', '***'
        ]
        return any(indicator in text for indicator in markdown_indicators)
    
    async def ask(self, query: str, context: Optional[str] = None, conversation_history: Optional[List[Dict]] = None) -> AIResponse:
        """
        Enviar consulta a la IA y obtener respuesta
        
        Args:
            query: Pregunta o consulta del usuario
            context: Contexto adicional opcional
            conversation_history: Historial de conversación para contexto
            
        Returns:
            AIResponse con la respuesta de la IA
        """
        if not self.is_initialized:
            return AIResponse(
                content="❌ Motor de IA no disponible. Verifique la configuración de Gemini API.",
                success=False,
                error_message="AI engine not initialized"
            )
        
        try:
            import time
            start_time = time.time()
            
            logger.info(f"Estado de grounding: {self.grounding_enabled}")
            
            if self.grounding_enabled:
                # Modo GROUNDING: Respuesta natural con búsqueda online
                logger.info("Usando modo GROUNDING (respuesta natural con búsqueda)")
                return await self._ask_grounding_mode(query, context, conversation_history, start_time)
            else:
                # Modo NO-GROUNDING: Respuesta estructurada con comandos/código
                logger.info("Usando modo NO-GROUNDING (respuesta estructurada)")
                return await self._ask_structured_mode(query, context, conversation_history, start_time)
                
        except Exception as e:
            self.logger.error(f"Error en consulta AI: {e}")
            return AIResponse(
                content=f"❌ Error al consultar IA: {str(e)}",
                success=False,
                error_message=str(e)
            )
    
    async def _ask_grounding_mode(self, query: str, context: Optional[str], conversation_history: Optional[List[Dict]], start_time: float) -> AIResponse:
        """Modo grounding: respuesta natural CON búsqueda online"""
        # Preparar prompt con contexto
        prompt = self._build_conversation_prompt(query, context, conversation_history, grounding_mode=True)
        
        # Configuración para grounding con respuesta de texto plano
        generation_config = types.GenerateContentConfig(
            response_mime_type="text/plain"
        )
        
        # Llamada a Gemini CON grounding usando nueva API
        response_stream = self.client.models.generate_content_stream(
            model=self.model_name,
            contents=[types.Content(
                role="user",
                parts=[types.Part.from_text(text=prompt)]
            )],
            config=generation_config
        )
        
        # Recopilar respuesta completa
        full_response = ""
        for chunk in response_stream:
            if chunk.text:
                full_response += chunk.text
        
        processing_time = time.time() - start_time
        
        if full_response:
            is_markdown = self._detect_markdown(full_response)
            return AIResponse(
                content=full_response,
                success=True,
                is_markdown=is_markdown,
                processing_time=processing_time,
                is_structured=False
            )
        else:
            return AIResponse(
                content="❌ No se recibió respuesta de la IA",
                success=False,
                error_message="Empty response from AI"
            )
    
    async def _ask_structured_mode(self, query: str, context: Optional[str], conversation_history: Optional[List[Dict]], start_time: float) -> AIResponse:
        """Modo estructurado: respuesta con comandos y código SIN grounding"""
        try:
            # Preparar prompt para respuesta estructurada
            prompt = self._build_conversation_prompt(query, context, conversation_history, grounding_mode=False)
            
            # Configuración según el ejemplo de NUEVAS_CARACTERISTICAS.MD
            generation_config = types.GenerateContentConfig(
                response_mime_type="application/json",
                response_schema=types.Schema(
                    type=types.Type.OBJECT,
                    required=["suggested_comands", "suggested_code_snippets"],
                    properties={
                        "general__answer": types.Schema(type=types.Type.STRING),
                        "suggested_comands": types.Schema(
                            type=types.Type.ARRAY,
                            items=types.Schema(type=types.Type.STRING)
                        ),
                        "suggested_code_snippets": types.Schema(
                            type=types.Type.ARRAY,
                            items=types.Schema(type=types.Type.STRING)
                        )
                    }
                )
            )
            
            # Llamada a Gemini SIN grounding usando nueva API
            response_stream = self.client.models.generate_content_stream(
                model=self.model_name,
                contents=[types.Content(
                    role="user",
                    parts=[types.Part.from_text(text=prompt)]
                )],
                config=generation_config
            )
            
            # Recopilar respuesta completa
            full_response = ""
            for chunk in response_stream:
                if chunk.text:
                    full_response += chunk.text
            
            processing_time = time.time() - start_time
            
            if full_response:
                # Parsear respuesta JSON
                try:
                    logger.info(f"Respuesta estructurada recibida: {full_response}")
                    parsed_response = json.loads(full_response)
                    logger.info(f"JSON parseado correctamente: {parsed_response}")
                    
                    return AIResponse(
                        content=parsed_response.get("general__answer", ""),
                        success=True,
                        is_markdown=False,
                        processing_time=processing_time,
                        suggested_commands=parsed_response.get("suggested_comands", []),  # Nota: comands sin 'm'
                        suggested_code_snippets=parsed_response.get("suggested_code_snippets", []),
                        is_structured=True
                    )
                except json.JSONDecodeError as je:
                    # Fallback a respuesta simple si no se puede parsear JSON
                    return AIResponse(
                        content=full_response,
                        success=True,
                        is_markdown=self._detect_markdown(full_response),
                        processing_time=processing_time,
                        is_structured=False
                    )
            else:
                return AIResponse(
                    content="❌ No se recibió respuesta de la IA",
                    success=False,
                    error_message="Empty response from AI"
                )
                
        except Exception as e:
            # Fallback a modo simple en caso de error
            try:
                prompt = f"Usuario: {query}"
                if context:
                    prompt = f"Contexto: {context}\n\n{prompt}"
                    
                fallback_config = types.GenerateContentConfig(
                    response_mime_type="text/plain"
                )
                
                response_stream = self.client.models.generate_content_stream(
                    model=self.model_name,
                    contents=[types.Content(
                        role="user",
                        parts=[types.Part.from_text(text=prompt)]
                    )],
                    config=fallback_config
                )
                
                fallback_response = ""
                for chunk in response_stream:
                    if chunk.text:
                        fallback_response += chunk.text
                        
                processing_time = time.time() - start_time
                
                return AIResponse(
                    content=fallback_response if fallback_response else f"Error: {str(e)}",
                    success=bool(fallback_response),
                    is_markdown=self._detect_markdown(fallback_response) if fallback_response else False,
                    processing_time=processing_time,
                    error_message=str(e) if not fallback_response else None
                )
            except Exception as fallback_error:
                return AIResponse(
                    content=f"Error: {str(e)} | Fallback error: {str(fallback_error)}",
                    success=False,
                    processing_time=time.time() - start_time,
                    error_message=str(e)
                )
    
    def _build_conversation_prompt(self, query: str, context: Optional[str], conversation_history: Optional[List[Dict]], grounding_mode: bool) -> str:
        """Construir prompt con historial de conversación"""
        prompt_parts = []
        
        # Agregar contexto si existe
        if context:
            prompt_parts.append(f"Contexto: {context}")
        
        # Agregar historial de conversación
        if conversation_history:
            prompt_parts.append("Historial de conversación:")
            for msg in conversation_history[-10:]:  # Solo últimos 10 mensajes
                role = msg.get("role", "")
                message = msg.get("message", "")
                if role and message:
                    prompt_parts.append(f"{role}: {message}")
        
        # Instrucciones específicas según el modo
        if grounding_mode:
            prompt_parts.append("""
Instrucciones: Proporciona una respuesta natural, conversacional y completa. 
Puedes buscar información actualizada si es necesario.
Usa markdown para formatear la respuesta si es apropiado.
""")
        else:
            prompt_parts.append("""
Instrucciones: Proporciona una respuesta estructurada en formato JSON con los siguientes campos:
- "general_answer": Respuesta general al usuario (string)
- "suggested_commands": Array de comandos de terminal útiles (array de strings)
- "suggested_code_snippets": Array de snippets de código relevantes (array de strings)

Solo usa tus conocimientos internos, no busques información online.
Focus en comandos prácticos y código útil para Linux.
""")
        
        # Agregar consulta actual
        prompt_parts.append(f"Usuario: {query}")
        
        return "\n\n".join(prompt_parts)
    
    def ask_sync(self, query: str, context: Optional[str] = None, conversation_history: Optional[List[Dict]] = None) -> AIResponse:
        """
        Versión síncrona de ask() para usar en interfaces que no soporten async
        """
        try:
            # Si ya hay un loop ejecutándose, usar run_until_complete puede fallar
            try:
                loop = asyncio.get_running_loop()
                # Si hay loop corriendo, crear tarea
                import concurrent.futures
                with concurrent.futures.ThreadPoolExecutor() as executor:
                    future = executor.submit(asyncio.run, self.ask(query, context))
                    return future.result()
            except RuntimeError:
                # No hay loop corriendo, usar asyncio.run
                return asyncio.run(self.ask(query, context, conversation_history))
        except Exception as e:
            return AIResponse(
                content=f"❌ Error en consulta síncrona: {str(e)}",
                success=False,
                error_message=str(e)
            )
    
    def get_status(self) -> Dict[str, Any]:
        """Obtener estado del motor de IA"""
        return {
            "initialized": self.is_initialized,
            "has_gemini": HAS_GEMINI,
            "has_api_key": bool(self.api_key),
            "model_name": "gemini-2.5-flash-lite-preview-06-17" if self.is_initialized else None
        }

# Instancia global del motor de IA
ai_engine = AIEngine()
